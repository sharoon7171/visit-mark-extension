{
  "manifest_version": 3,
  "name": "VisitMark - Highlight visited links with custom colors",
  "version": "1.0.9",
  "description": "VisitMark highlights visited links in your chosen colors. Global default and site specific appearance. Settings sync with Chrome.",
  "icons": {
    "16": "icons/extension-icon.png",
    "32": "icons/extension-icon.png",
    "48": "icons/extension-icon.png",
    "128": "icons/extension-icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icons/extension-icon.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "history",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
